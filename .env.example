# Portland Ground-Truth Pilot Configuration

# Telegram Bot Credentials (Get from @BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Operator Chat ID (Send /start to @userinfobot to get your numeric ID)
TELEGRAM_OPERATOR_CHAT_ID="your_telegram_numeric_chat_id_here"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# Base URL for public webhooks / proof photos (e.g. your Cloudflare Tunnel URL)
BASE_PUBLIC_URL="http://127.0.0.1:8000"

# Operational Limits
MAX_ACTIVE_TASKS=1
DAILY_DISPATCH_LIMIT=3
TASK_EXPIRATION_MINUTES=15
LOCATION_COOLDOWN_HOURS=12
CLIENT_RATE_LIMIT_MINUTES=30
